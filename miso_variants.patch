@@ -0,0 +1,300 @@
+"""Assistant variants: one compact spec, several connection lists, one YAML each."""
+import json
+import os
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+os.environ.setdefault("QT_QPA_PLATFORM", "offscreen")
+
+import numpy as np
+import yaml
+
+from sxm_viewer._shared import QtCore, QtWidgets
+from sxm_viewer.gui.dialogs import position_coordinates_dialogs as pcd
+from sxm_viewer.gui.dialogs.miso_assistant_dialog import MISOAssistantDialog
+from sxm_viewer.utils import miso_assistant as ma
+from sxm_viewer.utils.miso_yaml import MISOExportError
+
+try:                                    # run from the repository root
+    from tests.test_miso_peptide_yaml import chain, sugar
+except ImportError:                     # run from inside tests/
+    from test_miso_peptide_yaml import chain, sugar
+
+
+def three_sugars():
+    return chain() + [sugar("Gal", "Gal.2", 6)]
+
+
+def link(donor, acceptor, donor_carbon="C1", acceptor_carbon="C4", anomer="beta"):
+    return {"donor": donor, "donor_carbon": donor_carbon, "acceptor": acceptor,
+            "acceptor_carbon": acceptor_carbon, "anomer": anomer}
+
+
+def reply(connections):
+    return json.dumps({"message": "ok", "proposal": {
+        "root": 1, "fixed_orientation": True, "connections": connections}})
+
+
+class VariantParsingTests(unittest.TestCase):
+    def parse(self, connections, instances=None):
+        return ma.parse_reply(reply(connections), instances or chain())
+
+    def test_single_values_give_one_ordinary_configuration(self):
+        _m, choices = self.parse([link(0, 1)])
+        self.assertEqual(choices.alternatives, [])
+        self.assertEqual(len(choices.connections), 1)
+
+    def test_scan_of_one_acceptor_carbon_gives_one_variant_per_carbon(self):
+        message, choices = self.parse([link(0, 1, acceptor_carbon=["C3", "C4", "C6"])])
+        self.assertEqual([v[0].acceptor_carbon for v in choices.alternatives],
+                         ["C3", "C4", "C6"])
+        self.assertEqual(choices.connections, choices.alternatives[0])
+        self.assertIn("3 valid variant(s) out of 3", message)
+
+    def test_invalid_combinations_are_discarded_and_counted(self):
+        carbons = ["C3", "C4", "C6"]
+        links = [link(0, 1, acceptor_carbon=carbons), link(2, 1, acceptor_carbon=carbons)]
+        message, choices = self.parse(links, three_sugars())
+        self.assertEqual(len(choices.alternatives), 6)          # 9 minus the 3 clashes
+        for variant in choices.alternatives:
+            self.assertNotEqual(variant[0].acceptor_carbon, variant[1].acceptor_carbon)
+        self.assertIn("6 valid variant(s) out of 9", message)
+        self.assertIn("3 rejected", message)
+
+    def test_anomer_can_be_scanned_too(self):
+        _m, choices = self.parse([link(0, 1, anomer=["alpha", "beta"])])
+        self.assertEqual([v[0].anomer for v in choices.alternatives], ["alpha", "beta"])
+
+    def test_a_single_invalid_combination_is_still_a_clear_error(self):
+        bad = [link(0, 1, acceptor_carbon="C4"), link(2, 1, acceptor_carbon="C4")]
+        with self.assertRaisesRegex(ma.AssistantError, "failed local validation"):
+            self.parse(bad, three_sugars())
+
+    def test_no_valid_combination_reports_the_first_reason(self):
+        bad = [link(0, 1, anomer=["alpha", "beta"]), link(2, 1)]
+        with self.assertRaisesRegex(ma.AssistantError, "none of the"):
+            self.parse(bad, three_sugars())
+
+    def test_ceiling_on_combinations_checked(self):
+        with patch.object(ma, "MAX_VARIANT_COMBINATIONS", 2):
+            with self.assertRaisesRegex(ma.AssistantError, "more than the 2"):
+                self.parse([link(0, 1, acceptor_carbon=["C3", "C4", "C6"])])
+
+    def test_lists_must_hold_text(self):
+        for bad in ([], [1, 2], [["C4"]]):
+            with self.assertRaisesRegex(ma.AssistantError, "invalid types"):
+                self.parse([link(0, 1, acceptor_carbon=bad)])
+
+    def test_prompt_teaches_variants_without_a_leftover_marker(self):
+        self.assertIn("VARIANTS", ma.SYSTEM_PROMPT)
+        self.assertNotIn("PLACEHOLDER", ma.SYSTEM_PROMPT)
+
+
+def fake_image(self):
