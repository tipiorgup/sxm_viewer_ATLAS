+class VariantDialogTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.app = QtWidgets.QApplication.instance() or QtWidgets.QApplication([])
+
+    def test_review_lists_every_variant_and_approval_returns_them(self):
+        _m, choices = ma.parse_reply(
+            reply([link(0, 1, acceptor_carbon=["C3", "C4", "C6"])]), chain())
+        dialog = MISOAssistantDialog(chain(), [], None, None)
+        try:
+            text = dialog._summary(choices)
+            for number in (1, 2, 3):
+                self.assertIn(f"v{number}:", text)
+            self.assertIn("Variants: 3", text)
+            dialog._online_choices = choices
+            dialog.variant_gallery.set_variants(
+                choices.alternatives, {"root": 1, "fixed_orientation": True}, [], "")
+            dialog._approve_online()
+            self.assertEqual(len(dialog.result_choices.alternatives), 3)
+        finally:
+            dialog.deleteLater()
+
+    def make_dialog(self, carbons):
+        _m, choices = ma.parse_reply(reply([link(0, 1, acceptor_carbon=carbons)]), chain())
+        dialog = MISOAssistantDialog(chain(), [], None, None)
+        dialog._online_choices = choices
+        dialog.variant_gallery.set_variants(
+            choices.alternatives, {"root": 1, "fixed_orientation": True}, [], "")
+        return dialog, choices
+
+    def test_gallery_shows_a_sketch_and_keep_box_for_each_variant(self):
+        dialog, _c = self.make_dialog(["C3", "C4", "C6"])
+        try:
+            boxes = dialog.variant_gallery.findChildren(QtWidgets.QCheckBox)
+            self.assertEqual(len(boxes), 3)
+            self.assertTrue(all(b.isChecked() for b in boxes))
+        finally:
+            dialog.deleteLater()
+
+    def test_discarded_variants_are_not_returned(self):
+        dialog, _c = self.make_dialog(["C3", "C4", "C6"])
+        try:
+            dialog.variant_gallery.findChildren(QtWidgets.QCheckBox)[1].setChecked(False)
+            dialog._approve_online()
+            kept = dialog.result_choices.alternatives
+            self.assertEqual([v[0].acceptor_carbon for v in kept], ["C3", "C6"])
+        finally:
+            dialog.deleteLater()
+
+    def test_one_kept_variant_becomes_a_plain_configuration(self):
+        dialog, _c = self.make_dialog(["C3", "C4", "C6"])
+        try:
+            dialog.variant_gallery._toggle(0, False)
+            dialog.variant_gallery._toggle(2, False)
+            dialog._approve_online()
+            self.assertEqual(dialog.result_choices.alternatives, [])
+            self.assertEqual(dialog.result_choices.connections[0].acceptor_carbon, "C4")
+        finally:
+            dialog.deleteLater()
+
+    def test_discarding_everything_blocks_approval(self):
+        dialog, _c = self.make_dialog(["C3", "C4", "C6"])
+        try:
+            with patch.object(QtWidgets.QMessageBox, "warning") as warn:
+                dialog.variant_gallery._set_all(False)
